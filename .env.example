# ------------------------------------------------------------
# Awad Educational Academy — environment configuration
#
# Copy this file to `.env` (or set the variable in your hosting
# provider):
#   • Cloudflare Pages → Settings → Environment variables (Production)
#   • Vercel → Project Settings → Environment Variables
# ------------------------------------------------------------

# The canonical production URL of the website, WITHOUT a trailing slash.
# This drives canonical URLs, Open Graph URLs, structured data, robots.txt
# and sitemap.xml. When the final custom domain is connected, change ONLY
# this value — nothing else in the code needs to be edited.
#
# Examples:
#   VITE_SITE_URL=https://awadeducationalacademy.com
#   VITE_SITE_URL=https://awad-educational-academy.vercel.app
#
# If unset, the app falls back to the current Vercel deployment URL.
VITE_SITE_URL=https://awad-educational-academy.vercel.app

# ------------------------------------------------------------
# Google Analytics 4 (optional)
#
# Paste the academy's GA4 Measurement ID here to enable analytics.
# While this is empty, NO analytics script loads and no data is sent —
# the tracking code stays completely inert. Set it in your hosting
# provider's environment variables for production.
#
# Example:
#   VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
